server:
  port: 8080

spring:
  application:
    name: rag-server
  datasource:
    url: jdbc:mysql://服务器IP:3306/rag_agent?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
    username: rag_agent
    password: 你的MySQL密码
    driver-class-name: com.mysql.cj.jdbc.Driver

# ==================== ChromaDB 配置 ====================
chromadb:
  url: http://服务器IP:8000
  collection-name: products

# ==================== 火山引擎 API 配置 ====================
# API Key 通过环境变量注入，不要硬编码到代码中
# Windows 设置环境变量：setx VOLCENGINE_API_KEY "你的key"
volcengine:
  api-key: ${VOLCENGINE_API_KEY:你的API_KEY}
  base-url: https://ark.cn-beijing.volces.com/api/v3
  model-id: 你的模型endpoint-id
  embedding-model: doubao-embedding-vision

# ==================== RAG 参数 ====================
rag:
  top-k: 3
  similarity-threshold: 0.5
  max-context-messages: 10
