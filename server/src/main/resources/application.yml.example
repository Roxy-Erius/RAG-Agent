server:
  port: 8080

spring:
  application:
    name: rag-server
  datasource:
    url: jdbc:mysql://服务器IP:3306/rag_agent?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
    username: rag_agent
    password: 你的MySQL密码
    driver-class-name: com.mysql.cj.jdbc.Driver
  # ==================== Flyway 数据库版本管理 ====================
  # 启动时自动执行 db/migration 下的迁移脚本；全新库会建出全部表
  # 已有数据的库通过 baseline-on-migrate 标记现状，不会重跑 V1
  flyway:
    enabled: true
    locations: classpath:db/migration
    baseline-on-migrate: true
    baseline-version: 1

# ==================== CORS（前端来源）====================
# 5173 = 导购端 web；5174 = 管理后台 admin。多个用逗号分隔。
web:
  cors:
    allowed-origins: http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ==================== ChromaDB 配置 ====================
chromadb:
  url: http://服务器IP:8000
  collection-name: products

# ==================== Chat 模型配置 ====================
# 任意 OpenAI 兼容协议的 Chat 模型皆可。本项目当前用 DeepSeek：
#   https://platform.deepseek.com  → API keys → 创建（sk- 开头）
# 也可换回阿里云百炼（DashScope）：
#   base-url: https://dashscope.aliyuncs.com/compatible-mode   model-id: qwen-max
volcengine:
  chat:
    base-url: https://api.deepseek.com/v1
    api-key: 你的_DEEPSEEK_API_KEY     # sk- 开头
    model-id: deepseek-chat            # 或 deepseek-reasoner

# ==================== 本地 Embedding 配置 ====================
# 后端启动时会自动拉起本地 embedding 服务（端口 8001），无需手动启动。
# 详见 docs/Day16-本地多模态Embedding服务.md
embedding:
  base-url: http://localhost:8001
  api-key: not-needed                # 占位，本地服务不校验
  model: chinese-clip-vit-base-patch16
  auto-start: true                   # 后端自动拉起 Python embedding 子进程
  # 若自动启动失败，可手动跑 server/embedding-service/start.bat

# ==================== RAG 参数 ====================
rag:
  top-k: 3
  similarity-threshold: 0.5
  max-context-messages: 10

# ==================== 数据集路径 ====================
dataset:
  path: ../ecommerce_agent_dataset

# ==================== LLM-as-Judge（评测用，可选）====================
# 用本地 M-Prometheus 当裁判（Ollama，OpenAI 兼容端点）。
# 起步：装 Ollama → ollama create m-prometheus（见 docs/LLM-as-Judge.md）
# 也可填任意 OpenAI 兼容的更强模型（Gemini/GPT 等）当独立裁判。
judge:
  base-url: http://localhost:11434/v1
  api-key: not-needed
  model-id: m-prometheus
  timeout-seconds: 180
