server:
  port: 8080

spring:
  application:
    name: rag-server
  datasource:
    url: jdbc:mysql://服务器IP:3306/rag_agent?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
    username: rag_agent
    password: 你的MySQL密码
    driver-class-name: com.mysql.cj.jdbc.Driver

# ==================== ChromaDB 配置 ====================
chromadb:
  url: http://服务器IP:8000
  collection-name: products

# ==================== Chat 模型配置 ====================
# 当前用阿里云百炼（DashScope）OpenAI 兼容协议
# 详见 https://bailian.console.aliyun.com/  申请 sk- 开头的 API key
volcengine:
  chat:
    base-url: https://dashscope.aliyuncs.com/compatible-mode
    api-key: 你的百炼API_KEY         # sk- 开头
    model-id: qwen-max                # 或 qwen-turbo / qwen-plus / qwen-max-latest

# ==================== 本地 Embedding 配置 ====================
# 需要先启动 server/embedding-service/start.bat（端口 8001）
# 详见 docs/Day16-本地多模态Embedding服务.md
embedding:
  base-url: http://localhost:8001
  api-key: not-needed                # 占位，本地服务不校验
  model: chinese-clip-vit-base-patch16

# ==================== RAG 参数 ====================
rag:
  top-k: 3
  similarity-threshold: 0.5
  max-context-messages: 10

# ==================== 数据集路径 ====================
dataset:
  path: ../ecommerce_agent_dataset
