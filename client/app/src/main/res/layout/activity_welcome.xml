<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F0EB"
    android:gravity="center_horizontal"
    android:paddingStart="32dp"
    android:paddingEnd="32dp"
    android:paddingTop="60dp"
    android:paddingBottom="36dp">

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Logo -->
    <TextView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:text="🤖"
        android:textSize="38sp"
        android:gravity="center"
        android:background="@drawable/bg_send_button" />

    <!-- App name -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AI 导购助手"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        android:letterSpacing="0.02" />

    <!-- Tagline -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="智能商品推荐 · 多轮对话\n让 AI 帮你发现好物"
        android:textColor="#A09080"
        android:textSize="13sp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:layout_marginTop="8dp" />

    <!-- Feature highlights -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="36dp"
        android:layout_marginBottom="36dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="💬"
                android:textSize="20sp"
                android:gravity="center"
                android:background="@drawable/bg_input_capsule" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI 对话\n智能导购"
                android:textColor="#A09080"
                android:textSize="10sp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="🛒"
                android:textSize="20sp"
                android:gravity="center"
                android:background="@drawable/bg_input_capsule" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="一键加购\n方便快捷"
                android:textColor="#A09080"
                android:textSize="10sp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="📋"
                android:textSize="20sp"
                android:gravity="center"
                android:background="@drawable/bg_input_capsule" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="会话记录\n随时回顾"
                android:textColor="#A09080"
                android:textSize="10sp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Login button -->
    <TextView
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="登 录"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="@drawable/bg_auth_button"
        android:layout_marginTop="12dp"
        android:elevation="3dp"
        android:clickable="true"
        android:focusable="true" />

    <!-- Register button -->
    <TextView
        android:id="@+id/btnRegister"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="注 册"
        android:textColor="#5C4A3A"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="@drawable/edittext_bg"
        android:layout_marginTop="12dp"
        android:elevation="1dp"
        android:clickable="true"
        android:focusable="true" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Skip -->
    <TextView
        android:id="@+id/btnSkip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="暂不登录，以游客身份体验  →"
        android:textColor="#B8A898"
        android:textSize="13sp"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true" />
</LinearLayout>
